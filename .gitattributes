# Normalize line endings to LF for text files across platforms.
* text=auto eol=lf

# Binary assets — never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated lockfile — keep as-is, treat as generated in diffs.
pnpm-lock.yaml linguist-generated=true
