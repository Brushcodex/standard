  "steps": [
    {
      "id": "s1",
      "title": "Base metal",
      "instruction": "Airbrush the armour with Steel.",
      "role": "basecoat",
      "targetArea": "armour plates",
      "paintRefs": ["steel"],
      "method": "airbrush",
      "coats": 2,
      "thinning": "2:1 paint:thinner",
      "expectedResult": "An even cold steel base.",
      "source": {
        "media": "tutorial",
        "startSeconds": 60,
        "endSeconds": 95,
        "label": "1:00-1:35"
      },
      "media": [
        {
          "url": "https://example.org/media/base-metal.jpg",
          "kind": "image",
          "caption": "After the steel basecoat",
          "license": { "spdxId": "CC-BY-4.0" },
          "rightsNote": "Photographed by the author."
        }
      ]
    },
    {
      "id": "s2",
      "instruction": "Apply Rust Wash into recesses and let it pool.",
      "role": "wash",
      "paintRefs": ["rust"],
      "mixNote": "About one part Rust Wash to four parts water — water is not a declared paint, so this mixture has no structured form.",
      "warnings": ["Do not flood flat plates; keep it in recesses."],
      "alternatives": [
        {
          "type": "mathematical",
          "paint": "bone",
          "note": "Nearest owned color by CIEDE2000 — a color-distance claim only."
        },
        {
          "type": "verified_practical",
          "paintRef": { "manufacturer": "Some Brand", "name": "Typhus-style Corrosion" },
          "note": "Verified against a physical test swatch."
        }
      ]
    },
    {
      "id": "s3",
      "instruction": "Edge highlight chipped areas with a steel/bone mix.",
      "role": "edge_highlight",
      "technique": "edge highlighting",
      "source": { "media": "tutorial", "startSeconds": 372, "label": "6:12" },
      "mix": [
        { "paint": "steel", "parts": 3 },
        { "paint": "bone", "parts": 1 }
      ],
      "mixNote": "3:1 Steel to Bonewhite, thinned until it flows off the edge of the brush.",
      "method": "brush"
    },
    {
      "id": "s4",
      "instruction": "Seal the model with matt varnish once everything is cured.",
      "role": "varnish",
      "technique": "spray varnish",
      "paintRefs": ["varnish"],
      "method": "airbrush",
      "source": { "startSeconds": 742.5, "label": "12:22" }
    }
  ],
