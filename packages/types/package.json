{
  "name": "@brushcodex/types",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Canonical Open Paint Format document TypeScript types, re-exported from the reference model.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openpaintformat/standard.git",
    "directory": "packages/types"
  },
  "homepage": "https://openpaintformat.org",
  "bugs": "https://github.com/openpaintformat/standard/issues",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brushcodex/validator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.14.13",
    "typescript": "7.0.2"
  }
}
