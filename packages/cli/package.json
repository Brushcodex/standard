{
  "name": "@brushcodex/cli",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Command-line tools for the BrushCodex open standard: validate documents/bundles and run conformance.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brushcodex/standard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://brushcodex.com/standard",
  "bugs": "https://github.com/Brushcodex/standard/issues",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "brushcodex-validate": "./dist/validate.js",
    "brushcodex-conformance": "./dist/conformance.js"
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "conformance": "tsx src/conformance.ts",
    "validate": "tsx src/validate.ts",
    "test": "node scripts/build.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brushcodex/fixtures": "workspace:*",
    "ajv": "^8",
    "ajv-formats": "^3",
    "fflate": "^0.8",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@brushcodex/validator": "workspace:*",
    "vitest": "2.0.5",
    "@types/node": "20.14.13",
    "esbuild": "0.21.5",
    "tsx": "^4.23.1",
    "typescript": "7.0.2"
  }
}
