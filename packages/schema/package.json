{
  "name": "@brushcodex/schema",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "The Open Paint Format JSON Schemas, as data (zero dependencies).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openpaintformat/standard.git",
    "directory": "packages/schema"
  },
  "homepage": "https://openpaintformat.org",
  "bugs": "https://github.com/openpaintformat/standard/issues",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "generated/", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "build": "node ./scripts/generate.mjs",
    "prepack": "node ./scripts/generate.mjs",
    "test": "node ./scripts/generate.mjs && node ./test.js"
  }
}
